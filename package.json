{
  "name": "plumia-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/index.js",
    "dev": "nodemon -r dotenv/config --exec ts-node src/index.ts",
    "db:create": "ts-node -r dotenv/config ./src/scripts/create-database.ts",
    "db:populate": "ts-node -r dotenv/config ./src/scripts/populate-database.ts",
    "db:seed": "npm run db:create & npm run db:populate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vercel/postgres": "^0.8.0",
    "express": "^4.19.2",
    "express-joi-validation": "^5.0.1",
    "joi": "^17.12.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.3",
    "dotenv": "^16.4.5",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
